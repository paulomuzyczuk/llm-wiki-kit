# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Per-user Claude Code settings (personal permission allowlists, local paths)
.claude/settings.local.json

# Secrets / credentials (defensive — skills should never contain these)
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.*
*.p12
credentials.json

# Project-context mirrors (synced from SKILL.md; not the source of truth)
*-skill.md

# Privacy guard denylist — supplied out-of-band, never committed (would leak names)
.private-denylist

# Private vault schema overlays — this repo may name only the public example
# vault (software-craft.json). A local lint run against a private vault may
# generate its own overlay here; it must stay untracked.
schema/vaults/*.json
!schema/vaults/software-craft.json

# Page-name guard inputs — out-of-band, they name private content
.private-pagenames
.private-pagenames-map
.private-vaults-root
